# =============================================================
# SplitTheBill — Environment Variables for Production
# Place this file at: /opt/splitthebill/.env on your EC2
# NEVER commit this file to git!
# =============================================================

# ─── Database (RDS MySQL) ──────────────────────────────────────
DB_HOST=<your-rds-endpoint>.rds.amazonaws.com
DB_USER=admin
DB_PASSWORD=YOUR_RDS_PASSWORD_HERE

# ─── JWT Secret (use a long random string, min 64 chars) ──────
# Generate: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_use_openssl_rand_-base64_64_to_generate_this_value

# ─── Frontend URL (EC2 IP or domain) ─────────────────────────
FRONTEND_URL=http://YOUR_EC2_PUBLIC_IP
# If using a domain:
# FRONTEND_URL=https://yourdomain.com

# ─── AWS S3 Credentials ───────────────────────────────────────
AWS_ACCESS_KEY=YOUR_AWS_ACCESS_KEY_HERE
AWS_SECRET_KEY=YOUR_AWS_SECRET_KEY_HERE
AWS_REGION=ap-south-1

# ─── Gemini AI (bill scan / OCR feature) ──────────────────────
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ─── Redis (runs locally on EC2) ─────────────────────────────
# No change needed if Redis runs on same EC2 instance
REDIS_HOST=127.0.0.1

# ─── Spring Profile ───────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
