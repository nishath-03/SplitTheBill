# =============================================================
# SplitTheBill — Environment Variables for Production
# Place this file at: /opt/splitthebill/.env on your EC2
# NEVER commit this file to git!
# =============================================================

# ─── Database ──────────────────────────────────────────────────
# Using H2 file-based database — NO MySQL needed!
# Data is stored at: /opt/splitthebill/data/splitdb.mv.db
# No DB credentials required.

# ─── JWT Secret (use a long random string, min 64 chars) ──────
# Generate on EC2: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_use_openssl_rand_-base64_64_to_generate_this_value

# ─── Frontend URL (EC2 IP or DuckDNS domain) ─────────────────
FRONTEND_URL=http://nishath-splitthebill.duckdns.org
# Or if using raw EC2 IP:
# FRONTEND_URL=http://3.14.80.100

# ─── AWS S3 (optional — only needed for PDF receipt export) ───
# Leave blank if you don't need PDF uploads
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-south-1

# ─── Gemini AI (for receipt photo scanning) ───────────────────
# Get free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ─── Spring Profile ───────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
